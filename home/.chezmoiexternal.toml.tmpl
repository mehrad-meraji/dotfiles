[".tmux/plugins/tpm"]
type = "git-repo"
url = "https://github.com/tmux-plugins/tpm"
refreshPeriod = "168h"

# ~/.vimrc sets rtp+=~/.vim/bundle/Vundle.vim; without this clone vim errors on
# every `call vundle#begin()` / `Plugin ...` line.
[".vim/bundle/Vundle.vim"]
type = "git-repo"
url = "https://github.com/VundleVim/Vundle.vim"
refreshPeriod = "168h"

[".config/tmux/plugins/catppuccin"]
type = "archive"
url = "https://github.com/catppuccin/tmux/archive/refs/tags/v2.1.2.tar.gz"
exact = true
stripComponents = 1
refreshPeriod = "168h"

# Cloned once, like karabiner: ~/nvim is a working checkout you edit, commit
# and pull yourself. With a refreshPeriod chezmoi ran `git pull --rebase`
# weekly, which fails as soon as the checkout has local edits (lazy-lock.json).
["nvim"]
type = "git-repo"
url = "https://github.com/mehrad-meraji/nvim"
