[".tmux/plugins/tpm"]
type = "git-repo"
url = "https://github.com/tmux-plugins/tpm"
refreshPeriod = "168h"

[".config/tmux/plugins/catppuccin"]
type = "archive"
url = "https://github.com/catppuccin/tmux/archive/refs/tags/v2.1.2.tar.gz"
exact = true
stripComponents = 1
refreshPeriod = "168h"

# Cloned once, like karabiner: ~/nvim is a working checkout you edit, commit
# and pull yourself. With a refreshPeriod chezmoi ran `git pull --rebase`
# weekly, which fails as soon as the checkout has local edits (lazy-lock.json).
["nvim"]
type = "git-repo"
url = "https://github.com/mehrad-meraji/nvim"


# Projects: cloned on a new machine, never pulled afterwards (no refreshPeriod).
# Removed on purpose: penpot, searxng (upstream clones), mmr-web (work org).
#
# Most of these are private, so cloning needs ~/.git-credentials, which only
# hasSecrets machines get. Without it git stops at a credential prompt and the
# whole apply aborts, so machines without secrets (the server, work laptops)
# skip the lot.
{{ if .hasSecrets -}}

