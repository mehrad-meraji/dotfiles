.oh-my-zsh/custom/**
.config/github-copilot/versions.json
!.config/nvim/.keep
.config/nvim/**
.ignorefiles/**
.config/fish/fish_variables
.symlinks/**
.config/zed/prompts/**
.config/alacritty/theme.toml

{{- /* Machines without Bitwarden (work, servers): skip secret-backed files
       instead of failing the whole apply. */}}
{{ if not .hasSecrets }}
.git-credentials
.ssh/key_age
.ssh/zippy-apple
.ssh/heisenberg-isolate
.ssh/taskscape
.claude/projects/**
{{ end }}

{{- /* Claude Code: runtime state, and skills installed by `npx skills` (~/.agents). */}}
.claude/skills/audit-taskscape/state/**
.claude/skills/audit-taskscape/logs/**
.claude/plugins/installed_plugins.json
.claude/plugins/known_marketplaces.json
.claude/skills/huashu-design
.claude/projects/*scratch-workspaces*
.claude/projects/*scratch-workspaces*/**

{{- /* authorized_keys only means something on the server. Laptops do not
       accept inbound SSH. Same for the server's own tools and agents. */}}
{{ if ne .machineRole "server" }}
.ssh/authorized_keys
.local/bin/colima-setup
.local/bin/pinentry-auto
.local/bin/service-deploy-key
.local/bin/home-server-backup
.local/bin/github-runner-register
.local/bin/drives-setup
.config/home-server-backup/**
Library/LaunchAgents/com.mehrad.home-server-backup.plist
Library/LaunchAgents/com.mehrad.docker-prune.plist
{{ end }}
{{- /* The sentinel CLI is only installed where the vault can render its config. */}}
{{ if not (and (eq .machineRole "server") .hasVault) }}
Library/LaunchAgents/com.mehrad.sentinel-agent.plist
{{ end }}

{{- /* Laptop-only. The run_after_ scripts that load these agents are already
       role-gated, but launchd loads every plist in ~/Library/LaunchAgents at
       login whether or not anything called launchctl, so the files themselves
       must stay off the server. */}}
{{ if eq .machineRole "server" }}
Library/LaunchAgents/com.mehrad.sync-terminal-theme.plist
Library/LaunchAgents/com.mehrad.taskscape-audit.plist
.local/bin/sync-terminal-theme
.config/alacritty/**
.config/zellij/**
.config/zed/**
{{ end }}
