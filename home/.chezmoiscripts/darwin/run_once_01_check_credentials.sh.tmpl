#!/bin/bash

## Spawn sudo in background subshell to refresh the sudo timestamp
prevent_sudo_timeout() {
  # Note: Don't use GNU expect... just a subshell (for some reason expect spawn jacks up readline input)
  echo "Please enter your sudo password to make changes to your machine"
  sudo -v # Asks for passwords
  ( while true; do sudo -v; sleep 40; done ) &   # update the user's timestamp
  export sudo_loop_PID=$!
}

# Hack to make sure sudo caches sudo password correctly...
# And so it stays available for the duration of the Chef run
prevent_sudo_timeout
readonly sudo_loop_PID  # Make PID readonly for security ;-)

trap 'kill "$sudo_loop_PID" 2>/dev/null' EXIT

# Xcode Command Line Tools, headless (no GUI dialog, works over SSH).
# The marker file makes softwareupdate list the CLT package; same trick the
# Homebrew installer uses. Runs before anything can hit a /usr/bin/git stub,
# which is what pops the GUI prompt.
if ! xcode-select -p >/dev/null 2>&1; then
  clt_marker=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
  touch "$clt_marker"
  clt_label=$(/usr/sbin/softwareupdate -l 2>/dev/null |
    grep -B 1 -E 'Command Line Tools' |
    awk -F'*' '/^ *\*/ {print $2}' |
    sed -e 's/^ *Label: //' -e 's/^ *//' |
    # Labels mix "Xcode-16.4" and "Xcode 26.0-26.0"; sort on the version, not the text.
    sed -E 's/.*Xcode[ -]([0-9.]+).*/\1	&/' |
    sort -V | tail -n1 | cut -f2)
  if [[ -n "$clt_label" ]]; then
    sudo /usr/sbin/softwareupdate -i "$clt_label"
    sudo /usr/bin/xcode-select --switch /Library/Developer/CommandLineTools
  else
    echo "Command Line Tools not offered by softwareupdate; run: xcode-select --install" >&2
  fi
  rm -f "$clt_marker"
fi

