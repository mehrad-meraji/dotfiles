{{ if eq .machineRole "laptop" -}}
#!/bin/bash
# Karabiner rewrites karabiner.json itself, so chezmoi only clones the repo once.
# After that, commit and pull ~/karabiner with git yourself.

if [[ ! -e ~/karabiner ]]; then
  git clone https://github.com/mehrad-meraji/karabiner ~/karabiner
fi

# Create symlink if karabiner exists and config directory doesn't
if [[ -d ~/karabiner && ! -e ~/.config/karabiner ]]; then
  ln -sf ~/karabiner ~/.config/karabiner
fi
{{ end -}}
