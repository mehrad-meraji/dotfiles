#!/bin/bash
# WebStorm font settings: size=12, line spacing=1.6 (JetBrains Mono)

OPTS_FILE="$HOME/.config/nvim/lua/config/options.lua"

if [ ! -f "$OPTS_FILE" ]; then
  echo "nvim options.lua not found at $OPTS_FILE, skipping"
  exit 0
fi

cat > "$OPTS_FILE" << 'EOF'
-- Options are automatically loaded before lazy.nvim startup
-- Default options that are always set: https://github.com/LazyVim/LazyVim/blob/main/lua/lazyvim/config/options.lua
-- Add any additional options here

-- Match WebStorm font settings (size: 12, line spacing: 1.6)
vim.o.guifont = "JetBrainsMonoNL Nerd Font:h12"
-- linespace approximates 1.6x line height: (1.6 - 1) * ~16px cell height = ~10px extra
vim.o.linespace = 10
EOF
