{{ if and (eq .machineRole "server") .hasVault -}}
#!/bin/sh
# Installs the sentinel CLI, per the Sentinel guide (Servers). The agent reads /etc/sentinel.conf, which
# run_onchange_install-sentinel-conf renders from the same vault entry.
#
# The binary is fetched once. To update it, delete /usr/local/bin/sentinel and
# re-run this with: chezmoi state delete-bucket --bucket=entryState && chezmoi apply
set -eu

url='{{ (index (rbwFields "Sentinel - meh-labs") "SENTINEL_URL").value }}'
url=${url%/}
bin=/usr/local/bin/sentinel

if [ ! -x "$bin" ]; then
  echo "chezmoi: installing sentinel CLI from $url/cli (sudo required)" >&2
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' EXIT INT TERM
  curl -fsSL "$url/cli" -o "$tmp"
  sudo mkdir -p /usr/local/bin
  sudo install -m 755 "$tmp" "$bin"
fi

# PATH: cron's default is /usr/bin:/bin, and the agent needs docker from Homebrew.
# Every-minute readings come from the com.mehrad.sentinel-agent LaunchAgent
# (loaded by 60_launch-agents). An earlier version used cron; drop that line if
# it got in, so readings are not sent twice. Writing a crontab needs Full Disk
# Access, so this is best effort.
if crontab -l 2>/dev/null | grep -q 'sentinel agent'; then
  crontab -l 2>/dev/null | grep -v 'sentinel agent' | crontab - 2>/dev/null || true
fi
{{ end -}}
