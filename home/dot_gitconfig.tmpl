[user]
	name = Mehrad
	email = mehrad.meraji@gmail.com
[init]
	defaultBranch = main
[pull]
	rebase = true
[credential]
	helper =
{{- if .hasSecrets }}
	helper = store
{{- end }}
{{- if stat "/usr/local/share/gcm-core/git-credential-manager" }}
	helper = /usr/local/share/gcm-core/git-credential-manager
{{- end }}
[credential "https://dev.azure.com"]
	useHttpPath = true
{{- if lookPath "git-lfs" }}
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{- end }}
