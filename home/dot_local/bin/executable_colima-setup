#!/bin/bash
# (Re)configure the colima VM that runs every docker stack on the home server,
# then hand it to `brew services` so it comes back after a reboot.
#
# Run by chezmoi on the first server apply and whenever this file changes.
#
# colima shares only $HOME with the VM. No stack bind-mounts anything under
# /Volumes (checked against the old box, 2026-10-05), so nothing else is shared
# by default. If a stack ever needs a drive, share it explicitly, e.g.
#   COLIMA_EXTRA_MOUNTS="/Volumes/Glacier" colima-setup
# Sharing a removable volume can also need Full Disk Access for colima.
#
# Stops colima while it runs, so every container restarts. Stacks come back
# through their compose restart policies.
#
# vm-type and mount-type are fixed when the VM is first created; changing them
# later needs `colima delete`, which destroys all volumes. CPU, memory and
# mounts can change on any run. Disk can only grow.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

CPUS=${COLIMA_CPUS:-10}
# Containers used ~5 GiB in Oct 2026 and Linux fills any spare VM memory with
# page cache that macOS never gets back, so keep this near real need.
MEMORY=${COLIMA_MEMORY:-12}  # GiB
DISK=${COLIMA_DISK:-250}     # GiB
# ssh forwards TCP only. grpc also forwards UDP (self-hosted RustDesk needs
# 21116/udp) but colima calls it experimental. COLIMA_PORT_FORWARDER=grpc colima-setup
FORWARDER=${COLIMA_PORT_FORWARDER:-ssh}

mounts=(--mount "$HOME:w")
for vol in ${COLIMA_EXTRA_MOUNTS:-}; do
  if [ -d "$vol" ]; then
    mounts+=(--mount "$vol:w")
  else
    echo "!! $vol is not attached; not shared with the VM." >&2
  fi
done

brew services stop colima >/dev/null 2>&1 || true
colima stop >/dev/null 2>&1 || true

# Flags passed to `start` are written back to the VM's colima.yaml, which is
# what `brew services` (colima start -f) reads at boot.
colima start --vm-type vz --mount-type virtiofs \
  --cpus "$CPUS" --memory "$MEMORY" --disk "$DISK" --port-forwarder "$FORWARDER" \
  "${mounts[@]}"
colima stop

brew services start colima
echo "==> colima: ${CPUS} CPUs, ${MEMORY} GiB, $FORWARDER forwarder, mounts: ${mounts[*]}"
