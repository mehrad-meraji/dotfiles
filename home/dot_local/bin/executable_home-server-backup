#!/bin/bash
# Nightly home server backup, run at 03:30 by com.mehrad.home-server-backup.
#   1. pg_dumpall every running Postgres container, using that container's own
#      client so version skew (15/16/17/18) is never an issue.
#   2. Tar every other named volume (SQLite files, uploads, MinIO objects).
#   3. restic-backup the dumps, the volume tarballs, ~/Services and the Obsidian
#      vault, .env files included: the restic repo is encrypted, and until home-server-services
#      exists this is the only copy of them.
#
# Restore:  restic -r /Volumes/Mehrad/restic snapshots
#           restic -r /Volumes/Mehrad/restic restore latest --target /tmp/restore
#
# launchd runs this without a terminal, so macOS cannot ask for permission to
# read the external drive. Grant restic and /bin/bash Full Disk Access once, or
# every run fails with "Operation not permitted".
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

export RESTIC_REPOSITORY="/Volumes/Mehrad/restic"
export RESTIC_PASSWORD_FILE="$HOME/.config/restic/password"
DUMPS="/Volumes/Mehrad/pgdumps"
LOG="$HOME/.local/state/home-server-backup.log"

mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1
echo "===== $(date '+%F %T') start ====="

if [ ! -d /Volumes/Mehrad ]; then
  echo "!! /Volumes/Mehrad is not mounted. Aborting."
  exit 1
fi
mkdir -p "$DUMPS"

# 1. Dump every container whose name or image looks like Postgres. The user
#    comes from the container's own POSTGRES_USER, since not every stack uses
#    the default.
failed=0
# If docker is down, still back up the files below; just flag the night as failed.
if ps_out=$(docker ps --format '{{.Names}}\t{{.Image}}' 2>&1); then
  containers=$(awk -F'\t' 'tolower($0) ~ /postgres|postgis|pgsql/ {print $1}' <<<"$ps_out")
else
  echo "!! docker is unreachable; no database dumps tonight: $ps_out"
  containers=""
  failed=1
fi
for c in $containers; do
  out="$DUMPS/$c.sql.gz"
  echo "-- dumping $c -> $out"
  # unset PGHOST etc.: Plane's db container sets PGHOST=plane-db, which forces
  # a TCP connection that wants a password instead of the local socket.
  if docker exec "$c" sh -c 'unset PGHOST PGPORT PGDATABASE; pg_dumpall -U "${POSTGRES_USER:-postgres}"' | gzip >"$out.tmp"; then
    mv "$out.tmp" "$out"
  else
    echo "!! dump failed for $c"
    rm -f "$out.tmp"
    failed=1
  fi
done

# 2. Every other named volume, as a tarball. Postgres data dirs are skipped
#    (dumped above, and a live copy of them is not consistent); so are logs,
#    caches and queues, which are rebuilt on start. Volumes are read while the
#    stack runs, so a SQLite file can be caught mid-write: good enough nightly,
#    and taskscape also streams to R2 with Litestream.
if docker info >/dev/null 2>&1; then
  mkdir -p "$DUMPS/volumes"
  pg_vols=$(for c in $containers; do
    docker inspect "$c" --format '{{range .Mounts}}{{if eq .Type "volume"}}{{.Name}} {{end}}{{end}}'
  done)
  for v in $(docker volume ls -q); do
    case " $pg_vols " in *" $v "*) continue ;; esac
    [[ $v =~ ^[0-9a-f]{64}$ ]] && continue                   # anonymous
    [[ $v =~ (logs|redis|mq|cache) ]] && continue
    echo "-- volume $v"
    if docker run --rm -v "$v":/from:ro alpine tar czf - -C /from . >"$DUMPS/volumes/$v.tgz.tmp"; then
      mv "$DUMPS/volumes/$v.tgz.tmp" "$DUMPS/volumes/$v.tgz"
    else
      echo "!! volume export failed for $v"
      rm -f "$DUMPS/volumes/$v.tgz.tmp"
      failed=1
    fi
  done
fi

# 3. restic.
restic snapshots >/dev/null 2>&1 || restic init

paths=("$DUMPS")
[ -d "$HOME/Services" ] && paths+=("$HOME/Services")
# The Obsidian vault: iCloud and Syncthing keep it in sync but have no history;
# this gives 7 daily, 4 weekly and 6 monthly restore points.
VAULT="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Notes"
[ -d "$VAULT" ] && paths+=("$VAULT")
restic backup \
  --tag home-server \
  --exclude-caches \
  --exclude "$HOME/Services/**/*.tgz" \
  "${paths[@]}"

restic forget --tag home-server \
  --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune

# 3. Tell Sentinel the backup ran. Its cron monitor alerts when a ping is
#    missed, so a failed or skipped night is reported by the silence.
HEARTBEAT="$HOME/.config/home-server-backup/heartbeat-url"
if [ "$failed" = 0 ] && [ -s "$HEARTBEAT" ]; then
  curl -fsS -m 10 -o /dev/null "$(cat "$HEARTBEAT")" || echo "!! heartbeat ping failed"
fi

echo "===== $(date '+%F %T') done (dump failures: $failed) ====="
exit "$failed"
