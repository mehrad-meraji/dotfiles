<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mehrad.docker-prune</string>

    <!-- Weekly, same as the old box: unused images and build cache older than
         a week. Stopped containers are left alone, so idle stacks keep their
         images, and volumes are never touched: those hold the databases. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>{{ .homebrewPath }}/bin/docker image prune -af --filter until=168h &amp;&amp; {{ .homebrewPath }}/bin/docker builder prune -f --filter until=168h</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/docker-prune.log</string>

    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/docker-prune.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
