<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mehrad.sentinel-agent</string>

    <!-- One server reading for Sentinel, every minute. A LaunchAgent rather
         than cron: writing a crontab needs Full Disk Access on current macOS. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/sentinel</string>
        <string>agent</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{ .homebrewPath }}/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/sentinel-agent.err</string>
</dict>
</plist>
