set fish_greeting
set TERM xterm-256color
set -gx SHELL {{ .homebrewPath }}/bin/fish

set -gx LANG "en_US.UTF-8"
set -gx LC_CTYPE "en_US.UTF-8"

set -gx XDG_DATA_HOME {{ .chezmoi.homeDir -}}/.local/share
set -gx XDG_CONFIG_HOME {{ .chezmoi.homeDir -}}/.config
set -gx XDG_STATE_HOME {{ .chezmoi.homeDir -}}/.local/state
set -gx FISH_CONFIG_HOME $XDG_CONFIG_HOME/fish

# Herd injected PHP 8.4 configuration.
set -gx HERD_PHP_84_INI_SCAN_DIR "{{ .chezmoi.homeDir -}}/Library/Application Support/Herd/config/php/84/"

set -gx EDITOR nvim
set -gx PAGER bat
set -gx SYSTEMD_EDITOR $EDITOR
set -gx VISUAL $EDITOR

set -gx SSH_AUTH_SOCK {{ .chezmoi.homeDir }}/.bitwarden-ssh-agent.sock

## Source custom configs
for file in $FISH_CONFIG_HOME/custom.d/*.fish
    source $file
end

eval ({{- .homebrewPath -}}/bin/brew shellenv)

set -gx JETBRAINS_HOME {{ .chezmoi.homeDir }}/.config/jetbrains
if not string match -q -- $JETBRAINS_HOME $PATH
    set -gx PATH "$JETBRAINS_HOME" $PATH
end

fish_add_path {{ .chezmoi.homeDir }}/.cargo/bin
fish_add_path {{ .chezmoi.homeDir }}/.bun/bin

set -gx PNPM_HOME $XDG_DATA_HOME/pnpm
if not string match -q -- $PNPM_HOME $PATH
    set -gx PATH "$PNPM_HOME" $PATH
end

if type -q mise
    if status is-interactive
        mise activate fish | source
    else
        mise activate fish --shims | source
    end
end

if type -q starship
    if status is-interactive
        starship init fish | source
    end
end

if type -q zoxide
    if status is-interactive
        zoxide init fish | source
    end
end

if type -q direnv
    direnv hook fish | source
end

