# libpq (PostgreSQL client) build flags
set -gx LDFLAGS "-L{{ .homebrewPath }}/opt/libpq/lib"
set -gx CPPFLAGS "-I{{ .homebrewPath }}/opt/libpq/include"
set -gx PKG_CONFIG_PATH "{{ .homebrewPath }}/opt/libpq/lib/pkgconfig"
fish_add_path {{ .homebrewPath }}/opt/libpq/bin

# Age encryption (public key — safe to publish)
set -gx AGE_PUBLIC_KEY "age1yds3tez2pyfda2nputpnd9vqqf6rm6al7a92rd82ah5mcflk4gds2jgdnd"

# Bun
set -gx BUN_INSTALL "{{ .chezmoi.homeDir }}/.bun"
fish_add_path $BUN_INSTALL/bin

# TMUX Plugin Manager
set -gx TMUX_PLUGIN_MANAGER_PATH "{{ .chezmoi.homeDir }}/.tmux/plugins/tpm"
