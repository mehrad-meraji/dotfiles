# FZF Configuration
# =================

set -gx FZF_TMUX_OPTS "-p 55%,60%"
set -gx FZF_DEFAULT_COMMAND 'fd --type f --hidden --follow --exclude .git'

# CTRL-T: File/Directory search with preview
set -gx FZF_CTRL_T_OPTS "
  --preview 'bat -n --color=always {}'
  --bind 'ctrl-/:change-preview-window(down|hidden|)'"

# CTRL-R: Command history search with preview
set -gx FZF_CTRL_R_OPTS "
  --preview 'echo {}' --preview-window up:3:hidden:wrap
  --bind 'ctrl-/:toggle-preview'
  --bind 'ctrl-y:execute-silent(echo -n {2..} | pbcopy)+abort'
  --color header:italic
  --header 'Press CTRL-Y to copy command into clipboard'"

# Initialize fzf key bindings if installed via homebrew
if test -f {{ .homebrewPath }}/opt/fzf/shell/key_bindings.fish
    source {{ .homebrewPath }}/opt/fzf/shell/key_bindings.fish
end
